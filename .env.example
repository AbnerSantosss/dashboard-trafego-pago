# Copie para .env e preencha. Nenhum valor real entra no repositório.
# App: sempre como app_user (sujeito a RLS). Senha app_user só vale no Postgres local do compose.
DATABASE_URL=postgres://app_user:app_user@127.0.0.1:5460/trafego
# Migrações e manutenção (dono das tabelas). Local: postgres/postgres.
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5460/trafego
API_PORT=3001
WEB_URL=http://localhost:3000
AUTH_SECRET=
NODE_ENV=development
LOG_LEVEL=info
# Webhooks (P3.1). Janela de timestamp e limite por fonte são opcionais.
WEBHOOK_JANELA_SEGUNDOS=300
WEBHOOK_LIMITE_POR_MINUTO=600
# Fallback (D13): usado só para fontes sem segredo cifrado no banco. JSON {"empresa/fonte":"segredo"}, nunca commitado.
WEBHOOK_SEGREDOS=
# Chave AES-256-GCM dos segredos de fonte (sources.secret_enc): 32 bytes em base64 ou hex.
# Obrigatória em produção; fora dela, se vazia, é derivada de AUTH_SECRET (com aviso no log).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WEBHOOK_CHAVE_CIFRA=
# E-mail de convites e de nova senha (SMTP). Sem SMTP_HOST nada é enviado; fora de produção o
# link aparece no log da API. Em desenvolvimento a API também lê apps/api/.env.local (ignorado no git).
SMTP_HOST=
SMTP_PORT=465
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=
# Meta Ads: versão da Graph API (opcional, padrão v23.0). Os tokens das contas são colados na aba
# Configurações → Meta Ads e ficam cifrados no banco com WEBHOOK_CHAVE_CIFRA; nunca vão para cá.
META_GRAPH_VERSAO=

# Web
# URL da API vista pelo servidor do Next (padrão http://localhost:3001).
API_URL=
# Slug da empresa enviado em x-tenant (padrão pasio).
WEB_EMPRESA=
# Sessão provisória: e-mail enviado a POST /auth/sessao-dev (padrão admin@pasio.local).
WEB_USUARIO_EMAIL=
# Fallback sem /auth/sessao-dev: uuid do usuário (claim sub, assinado com AUTH_SECRET).
WEB_USUARIO_ID=
# 1 = dados da fixture no lugar da API (só testes visuais).
WEB_MOCK_API=
# Origem pública da API (https://...), usada nos endereços de webhook e na Tag GTM.
WEBHOOK_URL_PUBLICA=
# 1 = exige login também em desenvolvimento (em produção é sempre exigido).
WEB_EXIGIR_LOGIN=
