# Copie para .env e preencha. Nenhum valor real entra no repositório.
# App: sempre como app_user (sujeito a RLS). Senha app_user só vale no Postgres local do compose.
DATABASE_URL=postgres://app_user:app_user@127.0.0.1:5460/trafego
# Migrações e manutenção (dono das tabelas). Local: postgres/postgres.
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5460/trafego
API_PORT=3001
WEB_URL=http://localhost:3000
AUTH_SECRET=
NODE_ENV=development
LOG_LEVEL=info
# Webhooks (P3.1). Janela de timestamp e limite por fonte são opcionais.
WEBHOOK_JANELA_SEGUNDOS=300
WEBHOOK_LIMITE_POR_MINUTO=600
# Provisório até P5.2 (segredo cifrado no banco): JSON {"empresa/fonte":"segredo"}, nunca commitado.
WEBHOOK_SEGREDOS=
