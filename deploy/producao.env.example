# Variáveis da stack de produção (Portainer → Stacks → Environment variables).
# Nenhum segredo entra aqui: senhas do banco, AUTH_SECRET e a chave de cifra são gerados no próprio
# servidor pelo serviço `segredos` da stack (D39). Nenhum valor real entra no repositório.

# Endereços públicos (https, sem barra no fim).
WEB_URL=
# Origem pública da API: endereço dos webhooks e da Tag GTM.
WEBHOOK_URL_PUBLICA=

# Administrador inicial. Sem senha: o log do contêiner da API mostra um link de 1 hora para defini-la.
ADMIN_EMAIL=
ADMIN_NOME=

# Portas no 127.0.0.1 do servidor, para as rotas do túnel (padrão 3480 e 3481).
WEB_PORTA=
API_PORTA=

# E-mail de convites e de recuperação de senha (opcional; sem SMTP nada é enviado).
SMTP_HOST=
SMTP_PORT=465
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=

# Versão das imagens do GHCR (D41). Padrão `latest`; num rollback, fixe a tag de um commit
# (sha- seguido dos 7 primeiros caracteres do commit, como aparece no GHCR) e faça o redeploy.
# IMAGEM_TAG=latest

# Opcionais.
LOG_LEVEL=info
META_GRAPH_VERSAO=
