{
  "name": "@trafego/qa-visual",
  "private": true,
  "version": "0.1.0",
  "description": "Harness de regressão visual: Playwright captura a tela e pixelmatch compara com ref-1.png",
  "type": "module",
  "scripts": {
    "qa:visual": "node --experimental-strip-types comparar.ts",
    "qa:visual:update": "node --experimental-strip-types comparar.ts --somente-captura",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.6.0"
  }
}
